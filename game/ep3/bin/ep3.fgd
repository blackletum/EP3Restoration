@PointClass base(Parentname, Targetname, Angles) studio("models/weapons/hunter_flechette.mdl") = blob_shape_target :
	"Blob shape target - when enabled, this forms a chain (with other targets of the same 'shape name') that a blob can attach to. If visible, the blob will treat it as food (the blob chases the nearest food item)."
[
	startenabled(boolean) : "Start Enabled" : 1 : "If 'yes', this target should be enabled on map spawn (otherwise it will wait for an Enable input)."

	invisible(boolean) : "Invisible" : 0 : "Whether this target should be invisible (the blob will ignore it until receiving the AddShapeTarget input)."

	shapename(string) : "Name of target's Shape" : "" : "All targets with the same Shape Name will be chained together into a Shape"
	shapesequence(integer) : "Target's sequence number" : -1 : "A target's Sequence Number determines its position in the chain of targets constituting its Shape"
	shapesize(integer) : "Size of target's Shape" : -1 : "A Shape's size is the maximum number of targets it may contain - adding a new target beyond that size will cause the first added target to be destroyed ('-1' means 'maximum allowed size')"

	input Enable(void) : "Enable the target."
	input Disable(void): "Disable the target."
]

@PointClass base(Parentname, Targetname) sphere(radius) studio("models/chefhat.mdl") = blob_trigger :
	"Blob trigger - when enabled, fires OnStartTouchByBlob output when touched by a blob."
[
	startenabled(boolean) : "Start Enabled" : 1 : "If 'yes', this trigger should be enabled on map spawn (otherwise it will wait for an Enable input)."

	radius(float) : "Radius" : -1 : "The radius of this trigger. NOTE: in game, the trigger will be a cube. Default: 8."

	input Enable(void) : "Enable the trigger."
	input Disable(void): "Disable the trigger."

	output OnStartTouchByBlob(void) : "Fired when this trigger is physically touched by any blob."
	output OnStartDeliberateTouchByBlob(void) : "If this trigger is parented to an entity, fires when the blob attaches to that entity."
	output OnEndDeliberateTouchByBlob(void) : "If this trigger is parented to an entity, fires when the blob detaches from that entity."
]

@PointClass base(Parentname, Targetname) sphere(radius) studio("models/combine_helicopter/helicopter_bomb01.mdl") = blob_repeller :
	"Blob repeller - when enabled, blobs will be repelled from this point, out to the given radius, for the given duration."
[
	startenabled(boolean) : "Start Enabled" : 0 : "If 'yes', this repeller should be enabled on map spawn (the default is to wait for an input - or blob-proximity trigger, if 'shaper_repel_proximity' is set)."

	radius(float) : "Radius" : -1 : "The radius of influence within which this will repel blobs. Default: 8."
	repelduration(float) : "Repel duration" : -1 : "The duration for which this will repel blobs. Zero means 'infinite'. Default: 5."

	invisible(boolean) : "Invisible" : 0 : "Whether this repeller should be invisible."

	input Enable(void) : "Enable the repeller."
	input Disable(void): "Disable the repeller."
]
