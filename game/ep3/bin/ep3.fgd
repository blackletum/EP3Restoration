@SolidClass base(Targetname, Origin, EnableDisable) = func_pipe_entrance : "An opening into a system of pipes."
[
	pipesystemname(string) : "Pipe System Name" : : "Use the same name for all entrances to a single system."
	flowrate(float) : "Flow Rate" : 20 : "Number of blob particles that can fit through per second. Transfer speed is the minimum of two entrance's flow rates."
]

@PointClass base(Targetname, Parentname, Angles) studio("models/editor/axis_helper_thick.mdl") sphere(SearchRange) line(0 192 192, targetname, ApproachPath) = info_blob_spit_target : 
	"An entity that indicates a position where a blob tentacle can spit from"
[
	ApproachPath(target_destination) : "Approach Path" : : "[Optional] A info_blob_spit_path which the tentacle has to follow to use this target."
	SearchRange(float) : "Search Range" : 128 : "The tentacle will look within this sphere to keep LOS to the enemy."
]

@PointClass base(Targetname, Parentname, Angles) iconsprite("editor/info_target.vmt") line(255 255 255, targetname, NextPath) = info_blob_spit_path : 
	"An entity that indicates a position where a blob tentacle can spit from"
[
	NextPath(target_destination) : "Next Path" : : "A info_blob_spit_path or info_blob_spit_target which the tentacle has to go to next."
]

@NPCClass base(BaseNPC) studio("models/blob.mdl") = npc_blob : "Blob"
[
	blobType(choices) : "Blob Type" : 0 =
	[
		0 : "Generic"
		1 : "Leaper"
		2 : "Spitter"
		3 : "Spawner"
	]
	particlecount(integer) : "Particle Count" : 100 : "How many particles to use to simulate the blob."
	brainParticleCount(integer) : "Brain Particle Count" : 6 : "How many brain particles does this blob have (must be <= than the particle count)?"
	particle_radius(float) : "Particle Radius" : -1 : "The radius of the blob's particles. Default: 6.5"
	shakeFastBlobs(boolean) : "Spawn Fast Blobs" : 0
	startAsBrain(boolean) : "Spawn As Brain Only" : 0
	canMerge(boolean) : "Can Merge With Other Blobs" : 1
	
	input MoveToPosition(target_destination) : "Makes the blob go somewhere"
	input TestSplit(string) : "Split the blob in half along the X axis. Give the new blob a name."
	input UnseenTeleport(void) : "Teleport the blob somewhere near the player where they can't see."
	input OverloadPhysParamState(string) : "Forces the physics parameter state by name from the script file."
	input RevertPhysParamState(void) : "Allows physics parameter state to be set by internal AI code."
	input ForceThroughPipe(string) : "Causes the blob to move through a pipe instantly."
	input AddShapeTarget(string) : "Causes the blob to treat the given entity as a 'shape target', i.e. it will move to match its shape (works with npc_* and shape_target)."
	input RemoveShapeTarget(string) : "The opposite of AddShapeTarget."
	input TentacleAttackEntity(string) : "Makes the blob move within range of this entity, then attack it with a tentacle."
	input EnableShakeBlobs(bool) : "Enable/disable allowing the blob to choose to shake tiny blobs off itself."
	input EnableTentacleAttack(bool) : "Enable/disable allowing the blob to do its tentacle attack."
	input EnableSpit(bool) : "Enable/disable allowing the blob to do its spit attack."
	input EnableLeap(bool) : "Enable/disable allowing the blob to leap at the player."
	input EnableAutoRegeneration(bool) : "Enable/disable allowing the blob auto-regenerate its particles."
	input EnableSpawnRegenerators(bool) : "Enable/disable allowing the blob to spawn particle regenerators."
	input RegenerateParticles(float) : "Regenerate a fraction of the blob's particles. Argument should go from 0-1."
	
	output BlobSplit(void) : "This blob was just split. Activator is original blob, Caller is new blob."
	output BlobFrozen(void) : "This blob was just frozen."
	output BlobUnfrozen(void) : "This blob was just unfrozen."
	output OnBlobsShakenOff(void) : "This blob just spawned some tiny blobs"
	output OnBrainExposed(void) : "The brain for this blob was just exposed"
	output OnBrainHidden(void) : "The brain for this blob was just hidden by particle regeneration"
	output OnThreeQuartersArmor(void) : "Invoked when the blob transitions below three quarters of his total armor value"
]

@NPCClass base(npc_blob) studio("models/blob_tiny.mdl") = npc_blob_tiny : "Blob Tiny"
[
	splits(boolean) : "Blob spawns other blobs" : 0
	fastJumper(boolean) : "Fast Jump" : 0
	radius(float) : "Radius" : 7
	maxSplitCount(integer) : "Max Split Count" : 10

	input SplitOnce(float) : "Causes the blob to split exactly one time. Argument specifies how many seconds to wait before splitting"
]

